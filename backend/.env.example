# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# .env is gitignored — never commit real credentials.

# --- Database -----------------------------------------------------------
# This project expects PostgreSQL 17 with pgvector enabled, running on
# port 5433 (not the Postgres default of 5432 — see README for why).
DATABASE_URL=postgresql://YOUR_DB_USER@localhost:5433/scs_db

# --- Email notifications (optional) --------------------------------------
# If unset, escalation notifications are logged to the audit trail only —
# the app runs fine without these, no email is required for local dev/demo.
# For Gmail: SCS_SMTP_EMAIL is your address, SCS_SMTP_APP_PASSWORD is a
# 16-character App Password (not your normal login password) generated at
# https://myaccount.google.com/apppasswords
SCS_SMTP_EMAIL=
SCS_SMTP_APP_PASSWORD=

# Where escalation emails actually get sent in this demo (defaults to a
# role label if unset — see resolution_agent.py). Point this at your own
# inbox during local testing so you can see what an escalation looks like.
SCS_NOTIFY_TO=

# --- Slack notifications (optional) --------------------------------------
# ADDITIONAL channel alongside email, not a replacement — both fire on
# the same events (escalation, SLA breach) if configured. Leave unset
# and Slack notifications are silently skipped; nothing else breaks.
# Create an Incoming Webhook for your workspace at:
#   https://api.slack.com/messaging/webhooks
SCS_SLACK_WEBHOOK_URL=

# --- Scheduled executive reporting (optional) -----------------------------
# A weekly digest (exception counts, SLA health, at-risk suppliers, AI
# calibration) sent automatically on the schedule below, on whatever of
# email/Slack are configured above. Uses SCS_NOTIFY_TO for email if
# SCS_REPORT_RECIPIENT isn't set separately.
# Standard 5-field crontab syntax. Default: 8am every Monday.
SCS_REPORT_CRON=0 8 * * MON
SCS_REPORT_RECIPIENT=
